# ─── Database ──────────────────────────────────────────────────────────
# MySQL connection string (production)
#
# IMPORTANT for shared hosting (DirectAdmin, cPanel, etc.):
#   - connection_limit=1  → each serverless function opens only 1 connection
#   - pool_timeout=10     → wait max 10s for a connection before erroring
#
# Vercel serverless functions spin up multiple instances under load.
# Each instance creates its own PrismaClient. With connection_limit=1,
# 10 concurrent requests = max 10 connections (within typical shared
# hosting limits of 10-30 max_user_connections).
#
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?connection_limit=1&pool_timeout=10"

# ─── Auth ──────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET="generate-a-strong-random-secret"

# ─── CDN ───────────────────────────────────────────────────────────────
# Your CDN subdomain for image storage
CDN_URL="https://cdn.sanaathrumylens.co.ke"
# Must match the api_key in cdn-files/config.php on the CDN host
CDN_API_KEY="your-32-plus-character-api-key"

# ─── Email (SMTP) ──────────────────────────────────────────────────────
# DirectAdmin mail server credentials for sending emails (welcome, newsletter)
SMTP_HOST="mail.sanaathrumylens.co.ke"
SMTP_PORT="587"
SMTP_USER="noreply@sanaathrumylens.co.ke"
SMTP_PASS="your-email-password"
SMTP_FROM="noreply@sanaathrumylens.co.ke"
