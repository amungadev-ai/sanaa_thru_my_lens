# ─── Database ──────────────────────────────────────────────────────────
# MySQL connection string (production)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?connection_limit=2"

# ─── Auth ──────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET="generate-a-strong-random-secret"

# ─── CDN ───────────────────────────────────────────────────────────────
# Your CDN subdomain for image storage
CDN_URL="https://cdn.sanaathrumylens.co.ke"
# Must match the api_key in cdn-files/config.php on the CDN host
CDN_API_KEY="your-32-plus-character-api-key"
