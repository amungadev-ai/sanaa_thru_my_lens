// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Post {
  id              String    @id @default(cuid())
  title           String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(191)
  excerpt         String    @db.Text
  content         String    @db.LongText // HTML content
  coverImage      String?   @db.VarChar(500)
  category        String?   @db.VarChar(100)
  tags            String    @db.VarChar(500) // comma-separated tags
  author          String    @default("Sanaa Thrumylens") @db.VarChar(150)
  authorId        String?   @db.VarChar(30) // links to Editor
  status          String    @default("DRAFT") @db.VarChar(20) // IDEA | DRAFTING | IN_REVIEW | SCHEDULED | PUBLISHED | ARCHIVED
  scheduledAt     DateTime? // when the post is planned to go live (planning label for now)
  calendarNote    String?   @db.VarChar(500) // short note for the calendar
  featured        Boolean   @default(false)
  views           Int       @default(0)
  readingTime     Int       @default(5)
  notified        Boolean   @default(false) // true once subscribers have been emailed
  commentCount    Int       @default(0) // denormalized for performance
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  comments Comment[]
  editor   Editor? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([authorId])
  @@index([scheduledAt])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(120)
  description String? @db.Text
  color       String? @db.VarChar(100) // tailwind color class for accent
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(191)
  password  String   @db.VarChar(255)
  name      String   @db.VarChar(150)
  role      String   @default("ADMIN") @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id          String   @id @default(cuid())
  postId      String
  authorType  String   @db.VarChar(20) // READER | SUBSCRIBER | EDITOR | ADMIN
  authorId    String?  @db.VarChar(30) // Reader.id or Editor.id or AdminUser.id
  authorName  String   @db.VarChar(150)
  authorEmail String   @db.VarChar(191)
  content     String   @db.Text
  parentId    String?  @db.VarChar(30) // for one-level threading
  approved    Boolean  @default(false) // false = pending moderation, true = visible
  isEdited    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")
  votes    CommentVote[]

  @@index([postId])
  @@index([approved])
  @@index([parentId])
  @@index([authorType, authorId])
}

model CommentVote {
  id          String   @id @default(cuid())
  commentId   String
  voterType   String   @db.VarChar(20) // READER | SUBSCRIBER | EDITOR | ADMIN
  voterId     String   @db.VarChar(30)
  createdAt   DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, voterType, voterId]) // one vote per person per comment
  @@index([commentId])
}

model SiteSettings {
  id          String  @id @default("default") @db.VarChar(30)
  siteName    String  @default("Sanaa Thrumylens") @db.VarChar(150)
  tagline     String  @default("Art Through My Lens") @db.VarChar(200)
  description String? @db.Text
  logoText    String  @default("ST") @db.VarChar(10)
  socialTwitter   String? @db.VarChar(150)
  socialInstagram String? @db.VarChar(150)
  socialFacebook  String? @db.VarChar(255)
  socialEmail    String? @db.VarChar(191)
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(191)
  name      String?  @db.VarChar(150)
  status    String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | UNSUBSCRIBED
  source    String   @default("WEBSITE") @db.VarChar(50) // WEBSITE | IMPORT | MANUAL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Editor {
  id            String    @id @default(cuid())
  email         String    @unique @db.VarChar(191)
  name          String?   @db.VarChar(150)
  bio           String?   @db.Text
  avatar        String?   @db.VarChar(500)
  passwordHash  String?   @db.VarChar(255)
  role          String    @default("EDITOR") @db.VarChar(30) // EDITOR
  status        String    @default("PENDING") @db.VarChar(20) // PENDING | ACTIVE | SUSPENDED
  inviteToken   String?   @unique @db.VarChar(64)
  inviteExpires DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts Post[]

  @@index([status])
  @@index([email])
}

model Reader {
  id              String   @id @default(cuid())
  email           String   @unique @db.VarChar(191)
  name            String   @db.VarChar(150)
  passwordHash    String?  @db.VarChar(255) // optional — hybrid auth
  magicLinkToken  String?  @unique @db.VarChar(64)
  magicLinkExpiry DateTime?
  firstCommentApproved Boolean @default(false) // true after first comment is approved
  status          String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | SUSPENDED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([status])
}
